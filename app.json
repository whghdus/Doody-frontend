{
  "expo": {
    "name": "Doody",
    "slug": "Doody",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/favicon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "앱에서 프로필 사진 변경을 위해 갤러리 접근 권한이 필요합니다."
        }
      ]
    ],
    
    
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ko"
      }
    },
    
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/favicon.png"
      }
    },
    
    "web": {
      "favicon": "./assets/favicon.png",
      "template": "./index.html"
    }
  }
}